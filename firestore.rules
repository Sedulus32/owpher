rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /inboxes/{inboxKey} {
      // Public can read the public_key to encrypt, and write current_message + updated_at
      allow read: if true;
      allow update: if request.resource.data.keys().hasOnly(['current_message', 'updated_at']) || 
                       (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['current_message', 'updated_at']));
      allow create: if true;
    }
  }
}
